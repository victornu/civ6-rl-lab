# Allowlist the intended source tree; native/capture/training artifacts stay local.
*
!/.gitignore
!/README.md
!/AGENTS.md
!/LICENSE*
!/NOTICE*
!/pyproject.toml
!/requirements*.txt
!/src/
!/src/**
!/native/
!/native/**
!/include/
!/include/**
!/docs/
!/docs/**
!/examples/
!/examples/**
!/tests/
!/tests/**
!/config/
!/config/**
!/.github/
!/.github/**
# Never automatically include local/proprietary/runtime outputs.
**/__pycache__/
**/.venv/
**/*.pyc
**/*.egg-info/
**/*.dll
**/*.exe
**/*.pdb
**/*.db
**/*.sqlite*
**/*.Civ6Save
**/*.Civ6Map
**/*.pt
**/*.pth
**/*.pem
**/*.key
**/.env*
**/id_ed25519*
**/id_rsa*
**/work/
**/recordings/
**/private/
